{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run C++ with input.txt",
      "type": "shell",
      "command": "g++",
      "args": [
        "recursion.cpp",
        "-o",
        "recursion",
        "&&",
        "cmd",
        "/c",
        "recursion.exe < input.txt > output.txt"
      ],
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}