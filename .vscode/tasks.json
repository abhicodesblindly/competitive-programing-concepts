{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Run Active C++",
      "type": "shell",
      "command": "call \"${workspaceFolder}\\.vscode\\build_run.bat\"",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/C"]
        },
        "env": {
          "CPP_FILE": "${file}",
          "CPP_WORKSPACE": "${workspaceFolder}"
        },
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}